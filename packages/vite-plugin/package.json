{
  "name": "@lylyuanliang/agent-feedback-vite-plugin",
  "version": "1.0.0",
  "description": "Zero-code bundler plugin & DevServer middleware for Agent Feedback Bridge",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "node --experimental-strip-types --test tests/plugin.test.ts"
  },
  "dependencies": {
    "@lylyuanliang/agent-feedback-core": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "agent-feedback",
    "zero-code",
    "dev-server"
  ],
  "license": "MIT"
}
