{
  "name": "@lylyuanliang/agent-feedback-sentinel",
  "version": "1.0.0",
  "description": "Silent watcher CLI & pluggable AI Coding Agent wakeup adapters",
  "type": "module",
  "bin": {
    "agent-feedback": "./bin/cli.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "node --experimental-strip-types --test tests/sentinel.test.ts"
  },
  "dependencies": {
    "@lylyuanliang/agent-feedback-core": "workspace:*"
  },
  "keywords": [
    "agent-feedback",
    "sentinel",
    "watcher",
    "cli",
    "mcp",
    "antigravity",
    "coding-agent"
  ],
  "license": "MIT"
}
