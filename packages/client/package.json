{
  "name": "@lylyuanliang/agent-feedback-client",
  "version": "1.0.0",
  "description": "Shadow DOM Web Component and telemetry client for Agent Feedback Bridge",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "node --experimental-strip-types --test tests/client.test.ts"
  },
  "dependencies": {
    "@lylyuanliang/agent-feedback-core": "workspace:*"
  },
  "license": "MIT"
}
